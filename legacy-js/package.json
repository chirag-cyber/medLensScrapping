{
  "name": "pdp-link-scraper",
  "version": "1.0.0",
  "description": "Web scraper that extracts Product Detail Page (PDP) links from any website URL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scrape": "node cli.js",
    "batch:ingest": "node batch-job.js",
    "crawl": "node orchestrator.js",
    "crawl:salts": "node orchestrator.js --mode salts",
    "crawl:alphabet": "node orchestrator.js --mode alphabet",
    "crawl:resume": "node orchestrator.js --resume",
    "crawl:dry-run": "node orchestrator.js --dry-run",
    "interlink": "node interlink-medicines.js",
    "interlink:dry-run": "node interlink-medicines.js --dry-run",
    "targeted-enrich": "node targeted-enrichment.js --limit 50",
    "discover:alternatives": "node discover-alternatives.js --limit 50",
    "discover:alternatives:all": "node discover-alternatives.js --limit 500 --all",
    "fill:salt-dosage": "node fill-salt-dosage.js --apply --limit 50",
    "fill:salt-dosage:dry": "node fill-salt-dosage.js --limit 50",
    "backfill:dosage": "node backfill-dosage.js",
    "enrich": "node enrich-medicines.js --limit 50",
    "enrich:large": "node enrich-medicines.js --limit 500",
    "pipeline": "node orchestrator.js --resume --max-batches 10 && npm run interlink && npm run discover:alternatives && npm run fill:salt-dosage && npm run targeted-enrich && npm run enrich"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "express": "^4.18.0",
    "mongoose": "^9.3.3",
    "puppeteer": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
