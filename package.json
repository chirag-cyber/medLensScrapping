{
  "name": "pdp-link-scraper",
  "version": "1.0.0",
  "description": "Web scraper that extracts Product Detail Page (PDP) links from any website URL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scrape": "node cli.js",
    "batch:ingest": "node batch-job.js",
    "test:actual": "node test-actual.js",
    "enrich": "node enrich-medicines.js",
    "crawl": "node orchestrator.js",
    "crawl:salts": "node orchestrator.js --mode salts",
    "crawl:alphabet": "node orchestrator.js --mode alphabet",
    "crawl:resume": "node orchestrator.js --resume",
    "crawl:dry-run": "node orchestrator.js --dry-run"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "express": "^4.18.0",
    "mongoose": "^9.3.3",
    "puppeteer": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}